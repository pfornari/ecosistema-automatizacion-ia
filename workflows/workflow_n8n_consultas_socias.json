        "table": { "__rl": true, "mode": "name", "value": "Ejecuciones" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "fecha": "={{ $now.toISO() }}",
            "nodo": "Gmail · Enviar respuesta al socio",
            "resultado": "error",
            "detalle": "={{ $json.error ? $json.error.message : 'Fallo de envío Gmail' }}",
            "consulta": "={{ [$('Guardar consulta · Procesado por IA').item.json.id] }}",
            "workflow": "={{ $workflow.name }}",
