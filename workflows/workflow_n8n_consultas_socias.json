        "text": "=Borrador rechazado. La consulta de {{ $('Armar contexto de memoria').item.json.empresa }} queda pendiente de respuesta manual (registro {{ $('Guardar consulta · Procesado por IA').item.json.id }}).",
        "otherOptions": {}
      },
