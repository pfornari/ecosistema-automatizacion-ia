      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [2860, 100]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"ok\": true, \"mensaje\": \"Consulta recibida. Te respondemos por email a la brevedad.\" } }}",
        "options": { "responseCode": 202 }
      },
      "id": "n20",
      "name": "Responder 202 · consulta recibida",
      "type": "n8n-nodes-base.respondToWebhook",
