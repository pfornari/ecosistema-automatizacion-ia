            "enviado_en": "={{ $now.toISO() }}"
          }
        },
        "options": {}
      },
      "id": "n15",
      "name": "Airtable · Estado Aprobado y Enviado",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [2640, 100]
    },
    {
      "parameters": {
        "operation": "update",
        "base": { "__rl": true, "mode": "id", "value": "={{ $env.AIRTABLE_BASE_ID }}" },
