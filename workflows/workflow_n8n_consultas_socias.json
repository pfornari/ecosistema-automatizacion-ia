            "nodo": "Flujo completo",
            "resultado": "ok",
            "detalle": "=Consulta respondida. Tokens clasificación: {{ $('IA · Clasificar consulta (gpt-4.1-nano)').item.json.usage ? $('IA · Clasificar consulta (gpt-4.1-nano)').item.json.usage.total_tokens : 's/d' }}",
            "consulta": "={{ [$('Guardar consulta · Procesado por IA').item.json.id] }}",
            "modelo": "gpt-4.1-nano + claude-haiku-4-5",
            "workflow": "={{ $workflow.name }}",
